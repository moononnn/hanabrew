{
  "manifestVersion": 1,
  "id": "hanabrew",
  "name": "花酿",
  "version": "1.1.50",
  "minAppVersion": "0.938.0",
  "description": "在 Hana 里运行 SillyTavern：提供完整酒馆、角色来访、伙伴单向导出与角色卡体检；支持真实测卡与按节奏连续代笔对戏。",
  "trust": "full-access",
  "activationEvents": [
    "onStartup"
  ],
  "capabilities": [
    "session",
    "agent",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "*"
    ],
    "defaultTimeoutMs": 120000,
    "maxResponseBytes": 1048576
  },
  "contributes": {
    "cards": [
      {
        "id": "workspace",
        "type": "webview",
        "title": "花酿·工作台",
        "description": "角色来访、伙伴出口和角色卡体检都从这里进入。",
        "route": "/card/visitor",
        "face": {
          "image": "workspace.png"
        },
        "cardForm": "flush",
        "titlebar": "solid",
        "realization": "page",
        "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M4 7.5A2.5 2.5 0 0 1 6.5 5h4l2 2h5A2.5 2.5 0 0 1 20 9.5v7A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5z\"/><path d=\"M8 12h8M8 15h5\"/></svg>"
      },
      {
        "id": "tavern",
        "type": "webview",
        "title": "花酿·酒馆",
        "description": "在花酿里进入完整的 SillyTavern，继续角色卡、世界书和对话。",
        "route": "/tavern",
        "face": {
          "image": "tavern.png"
        },
        "cardForm": "flush",
        "titlebar": "solid",
        "realization": "page",
        "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5z\"/><path d=\"M4 9h16M8 13h3M8 16h6\"/></svg>"
      }
    ]
  }
}
